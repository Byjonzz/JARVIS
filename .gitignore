# Entornos virtuales
.venv/
venv/

# Variables de entorno y secretos
.env

# Archivos de caché y logs de Python
__pycache__/
*.pyc
guardia_log.txt

.config/

# Tokens de sesión de Spotify (¡secretos!)
.spotify_cache
.cache

# Datos de la red neuronal de aprendizaje (se generan con el uso)
config/neural_dataset.jsonl
config/neural_pesos.npz
config/neural_meta.json

# Huella biométrica de voz del usuario (dato personal, incluida su copia de seguridad)
config/voice_profile.npz
config/voice_profile.npz.bak

# Asa temporal para retomar la conversación tras un reinicio del núcleo
config/session_reanudar.json

# Captura temporal del módulo de visión
temp_vision.png
# Vistas previas del escultor de la cara (se regeneran con esculpir_cara.py)
